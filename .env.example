# ==========================================
# AI Food Recipe Generator - Configuration
# ==========================================

# Google Gemini API Key
# Step 1: Visit https://aistudio.google.com/app/apikey
# Step 2: Sign in with your Google Account and click "Create API Key"
# Step 3: Copy and paste your key below (replace your_gemini_api_key_here)
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model Name (Recommended: gemini-3.5-flash-lite)
GEMINI_MODEL=gemini-3.5-flash-lite

# Flask Secret Key (used for securely signing session cookies)
SECRET_KEY=student_recipe_secret_key_2026

# ==========================================
# Google Sign-In OAuth 2.0 Credentials (Optional)
# If left empty, instant 1-click Demo Sign-In is activated automatically.
# To connect live Google Cloud accounts, generate OAuth Client ID at:
# https://console.cloud.google.com/apis/credentials
# ==========================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ==========================================
# Supabase Cloud Database (Optional / Recommended)
# When configured, Mahilicious automatically switches from SQLite to Supabase!
# 1. Sign up free at: https://supabase.com
# 2. Create a new project (e.g. 'mahilicious')
# 3. Go to SQL Editor -> Paste and run 'supabase_schema.sql'
# 4. Go to Project Settings -> API
# 5. Copy "Project URL" and "anon / public" API key below:
# ==========================================
SUPABASE_URL=
SUPABASE_KEY=
